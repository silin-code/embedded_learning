# ============ OS & Editor ============
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ============ Common Build Artifacts ============
# Object files, dependency files, and linker outputs; regenerated on rebuild
*.o
*.obj
*.d
*.dep
*.lst
*.lnp
*.crf
*.axf
*.elf
*.map
*.htm
*.sct
*.bak
*.dlg
*.tra
*.iex

# ============ Keil MDK ============
# The directory under MDK-ARM named after the project holds build outputs
# (.o/.axf/.hex etc.), ignore it entirely
**/MDK-ARM/*/
# But RTE and DebugConfig are project configs and must be tracked
!**/MDK-ARM/RTE/
!**/MDK-ARM/DebugConfig/
# uvguix files are Keil GUI layouts, machine-specific, not tracked
*.uvguix.*

# ============ STM32CubeMX / STM32CubeIDE ============
# .mxproject is a private CubeMX cache, regenerated when reopening the project
.mxproject
# IDE build output directories
**/Debug/
**/Release/
# Note: *.ioc is the CubeMX project configuration and must be tracked,
# so it is intentionally NOT ignored

# ============ HAL / CMSIS Driver Libraries ============
# Drivers is the CubeMX-generated library (~65 MB); regenerate the project
# with CubeMX to restore it, not tracked
Drivers/

# ============ IAR EWARM ============
# settings under Debug is user debug configuration, regenerated anytime
**/settings/
*.ewt
*.dni
*.dbgdt

# ============ CMake / Make / GCC ============
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/

# ============ PlatformIO ============
.pio/

# ============ Logs ============
*.log
